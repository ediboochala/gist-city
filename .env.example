# Copy this file to .env.local and fill in the values when you connect real services.
# Without these, Gist City runs in "local mode": rooms work in your browser,
# messages sync between open tabs, and the city is kept lively with demo activity.

# --- Supabase (accounts, database, real-time chat) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LiveKit (live voice in rooms) ---
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- SMS verification (e.g. Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=GistCity

# --- Payments (later: fares and coin top-ups) ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
